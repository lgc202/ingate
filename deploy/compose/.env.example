COMPOSE_PROJECT_NAME=ingate
COMPOSE_SUBNET=172.31.250.0/24

APISERVER_ADMIN_TOKEN=ingate-dev-admin-token
ADMIN_API_TOKEN=ingate-dev-admin-api-token

APISERVER_PORT=18443
ADMIN_API_PORT=18080
XDS_SERVER_GRPC_PORT=19090
CONSOLE_PORT=8088
ENVOY_PROXY_PORT=10080
ENVOY_ADMIN_PORT=19901

GATEWAY_NAME=compose-gateway
ROUTE_NAME=compose-orders-route
BACKEND_NAME=compose-backend
GATEWAY_HOST=api.example.com
ROUTE_PATH_PREFIX=/orders

# Leave this as the sample-backend static IP for the bundled demo.
# If you change COMPOSE_SUBNET for the bundled demo, keep this and
# BACKEND_ENDPOINT_ADDRESS inside the same subnet.
SAMPLE_BACKEND_ADDRESS=172.31.250.10

# For a real external backend, replace it with a reachable numeric IP.
BACKEND_ENDPOINT_ADDRESS=172.31.250.10
BACKEND_ENDPOINT_PORT=8080
BACKEND_PROTOCOL=HTTP
