INGATE_IMAGE_REGISTRY=ghcr.io/lgc202
INGATE_VERSION=__INGATE_VERSION__
INGATE_DEPLOY_ROOT=./docker

# install.sh 会为管理密码、会话签名密钥、控制面令牌和数据库密码生成随机值
INGATE_ADMIN_PASSWORD=
INGATE_SESSION_SECRET=
INGATE_APISERVER_BEARER_TOKEN=
INGATE_MYSQL_PASSWORD=
INGATE_MYSQL_ROOT_PASSWORD=
INGATE_CLICKHOUSE_PASSWORD=

# 运维助手模型未配置时组件仍可启动；配置后支持 OpenAI Chat Completions 兼容服务
INGATE_ASSISTANT_MODEL_BASE_URL=
INGATE_ASSISTANT_MODEL_API_KEY=
INGATE_ASSISTANT_MODEL_NAME=

INGATE_BIND_ADDRESS=127.0.0.1
INGATE_CONSOLE_PORT=8001
INGATE_HTTP_PORT=8080
INGATE_HTTPS_PORT=8443

# 默认部署不创建 Trace 出口；设置地址即可接入外部 OTLP Collector
INGATE_ALS_TRACING_ENDPOINT=

# 设为 true 后，安装包的启停、备份、升级和卸载会统一包含可选观测栈
INGATE_OBSERVABILITY_ENABLED=false

# 观测服务没有外部认证，不跟随 Gateway 和 Console 的监听地址向外暴露
INGATE_OBSERVABILITY_BIND_ADDRESS=127.0.0.1
