apiVersion: v1
kind: Config
clusters:
  - cluster:
      insecure-skip-tls-verify: true
      server: __APISERVER_ADDRESS__
    name: ingate-compose
users:
  - name: ingate-admin
    user:
      token: __APISERVER_ADMIN_TOKEN__
contexts:
  - context:
      cluster: ingate-compose
      user: ingate-admin
    name: ingate-admin
current-context: ingate-admin
